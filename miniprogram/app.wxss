page {
  --td-brand-color: #0f8bff;
  --td-brand-color-focus: rgba(15, 139, 255, 0.12);
  --td-brand-color-light: #e8f2ff;
  --td-brand-color-active: #0c78de;
  --td-bg-color-page: #f6f9fb;
  --td-bg-color-container: #ffffff;
  --td-bg-color-secondarycontainer: #f8fafc;
  --td-bg-color-component: #eef2f7;
  --td-bg-color-component-active: #e2e8f0;
  --td-text-color-primary: #333333;
  --td-text-color-secondary: #667085;
  --td-text-color-placeholder: #cccccc;
  --td-text-color-disabled: #98a2b3;
  --td-text-color-anti: #ffffff;
  --td-component-border: #dbe4ee;
  --td-radius-small: 16rpx;
  --td-radius-medium: 20rpx;
  --td-radius-large: 28rpx;
  --td-radius-default: 20rpx;
  --td-font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;

  --app-bg: var(--td-bg-color-page);
  --app-surface: var(--td-bg-color-container);
  --app-surface-muted: var(--td-bg-color-secondarycontainer);
  --app-text: var(--td-text-color-primary);
  --app-text-secondary: var(--td-text-color-secondary);
  --app-text-muted: #98a2b3;
  --app-border: var(--td-component-border);
  --app-primary: var(--td-brand-color);
  --app-primary-weak: #e8f2ff;
  --app-success: #22c55e;
  --app-danger: #ef4444;

  background: var(--app-bg);
  color: var(--app-text);
  font-size: 28rpx;
  line-height: 1.6;
  min-height: 100%;
  font-family: var(--td-font-family);
}
.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.card {
  background: var(--app-surface);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--app-border);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.1);
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
  color: var(--app-text);
  line-height: 1.35;
}

.sub {
  color: var(--app-text-secondary);
  font-size: 24rpx;
  line-height: 1.6;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--app-text);
  line-height: 1.35;
}

.page-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
}

.page-head .title {
  margin-bottom: 8rpx;
}

.page-head .sub {
  max-width: 460rpx;
}

.btn-row,
.modal-actions,
.search-bar,
.tabs,
.stat-grid,
.action-grid {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.search-bar {
  align-items: center;
  flex-wrap: nowrap;
  margin-bottom: 24rpx;
}

.search-bar .input,
.search-bar .search-input {
  flex: 1;
  min-width: 0;
}

.search-bar button {
  flex-shrink: 0;
}

.input,
.textarea,
.picker,
.search-input,
.ai-input {
  width: 100%;
  box-sizing: border-box;
  background: var(--app-surface-muted);
  border: 1rpx solid var(--app-border);
  border-radius: 16rpx;
  padding: 22rpx;
  color: var(--app-text);
  font-size: 28rpx;
  line-height: 1.5;
}

.input,
.search-input,
.ai-input {
  min-height: 96rpx;
}

.textarea {
  min-height: 180rpx;
  line-height: 1.6;
}

.primary-btn,
.search-btn,
.add-btn,
.save-btn,
.edit-btn,
.tab.active,
.stat-item,
.menu-item,
.btn-primary {
  background: linear-gradient(135deg, #1677ff, #4f46e5);
  color: #fff;
}

.cancel-btn,
.btn-ghost {
  background: #eef2f7;
  color: #344054;
}

.del-btn,
.danger-btn,
.logout-btn {
  background: linear-gradient(135deg, #ff4d4f, #d92d20);
  color: #fff;
}

.search-btn,
.add-btn,
.edit-btn,
.save-btn,
.cancel-btn,
.del-btn,
.primary-btn,
.btn-primary,
.btn-ghost,
.danger-btn,
.logout-btn {
  border-radius: 16rpx;
  min-height: 88rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  background: var(--app-surface);
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.04);
}

.log-item {
  background: var(--app-surface);
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.04);
}

.item-info {
  flex: 1;
  min-width: 0;
}

.item-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--app-text);
}

.item-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--app-text-secondary);
  line-height: 1.5;
}

.log-title,
.log-action,
.log-query {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--app-primary);
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.log-detail {
  display: block;
  font-size: 24rpx;
  color: #475467;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.log-meta {
  display: block;
  font-size: 22rpx;
  color: var(--app-text-muted);
}

.actions {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.empty {
  text-align: center;
  color: var(--app-text-muted);
  padding: 72rpx 0;
  font-size: 24rpx;
}

.modal {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(16, 24, 40, 0.56);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 32rpx;
  box-sizing: border-box;
}

.modal-show {
  display: flex;
}

.modal-content {
  width: 100%;
  max-width: 680rpx;
  background: var(--app-surface);
  border-radius: 28rpx;
  padding: 32rpx;
  box-sizing: border-box;
  max-height: 82vh;
  overflow-y: auto;
  box-shadow: 0 24rpx 80rpx rgba(15, 23, 42, 0.2);
}

.modal-title {
  display: block;
  margin-bottom: 20rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--app-text);
}

.modal-actions {
  margin-top: 20rpx;
  justify-content: flex-end;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #175cd3;
  font-size: 22rpx;
}

.tabs {
  background: #eef2ff;
  border-radius: 20rpx;
  padding: 6rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 12rpx;
  border-radius: 16rpx;
  color: #475467;
  font-size: 24rpx;
}

.tab.active {
  box-shadow: 0 10rpx 24rpx rgba(22, 119, 255, 0.18);
}

.section-card {
  padding-top: 4rpx;
  padding-bottom: 4rpx;
}

.compact-card {
  padding: 20rpx;
}

.field {
  margin-bottom: 24rpx;
}

.label {
  display: block;
  margin-bottom: 10rpx;
  color: #344054;
  font-size: 26rpx;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 14rpx 0;
  color: #344054;
  font-size: 26rpx;
}

.stack-gap {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.full-width {
  width: 100%;
}

.muted {
  color: var(--app-text-muted);
}

.divider {
  height: 1rpx;
  background: #edf0f5;
  margin: 20rpx 0;
}

.content {
  padding-bottom: 40rpx;
}

.section-item,
.text-item,
.empty-hint {
  font-size: 24rpx;
  line-height: 1.7;
}

.section-item,
.text-item {
  color: #344054;
}

.empty-hint {
  color: var(--app-text-muted);
  padding: 16rpx 0;
}

.file-name {
  margin-top: 10rpx;
  color: var(--app-text-secondary);
  font-size: 24rpx;
}

.link-text {
  background: var(--app-surface-muted);
  border: 1rpx solid var(--app-border);
  border-radius: 16rpx;
  padding: 18rpx;
  font-size: 22rpx;
  color: var(--app-primary);
  word-break: break-all;
  margin-bottom: 10rpx;
}

.ai-answer,
.polish-result {
  background: var(--app-surface-muted);
  border: 1rpx solid var(--app-border);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--app-text);
  line-height: 1.7;
}

.log-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf0f5;
}

.log-row:last-child {
  border-bottom: none;
}

.log-main {
  flex: 1;
  min-width: 0;
}

.log-arrow {
  color: #cbd5e1;
  font-size: 40rpx;
  line-height: 1;
}

.ai-fab {
  position: fixed;
  right: 28rpx;
  bottom: 150rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #1677ff, #7c3aed);
  box-shadow: 0 16rpx 34rpx rgba(22, 119, 255, 0.32);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ai-fab-icon {
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.ai-panel {
  position: fixed;
  right: 28rpx;
  bottom: 270rpx;
  width: calc(100vw - 56rpx);
  max-width: 470rpx;
  background: var(--app-surface);
  border-radius: 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(226, 232, 240, 0.95);
  box-shadow: 0 20rpx 56rpx rgba(16, 24, 40, 0.16);
  z-index: 99;
  display: none;
}

.ai-panel-show {
  display: block;
}

.ai-panel-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.ai-close {
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 18rpx;
  background: #f2f4f7;
  color: #475467;
  font-size: 28rpx;
}

button::after {
  border: none;
}
