page {
  /* ===== DESIGN.md Design Tokens (Apple-style system) ===== */

  /* Brand & Accent - Action Blue */
  --app-color-primary: #0066cc;
  --app-color-primary-focus: #0071e3;
  --app-color-primary-on-dark: #2997ff;
  --app-color-primary-dark: #0052a3;
  --app-color-primary-light: #e6f0fa;

  /* Surface */
  --app-color-canvas: #ffffff;
  --app-color-canvas-parchment: #f5f5f7;
  --app-color-surface-pearl: #fafafc;
  --app-color-surface-tile-1: #272729;
  --app-color-surface-tile-2: #2a2a2c;
  --app-color-surface-tile-3: #252527;
  --app-color-surface-black: #000000;
  --app-color-surface-chip-translucent: #d2d2d7;

  /* Text */
  --app-color-ink: #1d1d1f;
  --app-color-body: #1d1d1f;
  --app-color-body-on-dark: #ffffff;
  --app-color-body-muted: #cccccc;
  --app-color-ink-muted-80: #333333;
  --app-color-ink-muted-48: #7a7a7a;

  /* Hairlines & Borders */
  --app-color-divider-soft: #f0f0f0;
  --app-color-hairline: #e0e0e0;

  /* Semantic aliases */
  --app-color-on-primary: #ffffff;
  --app-color-on-dark: #ffffff;

  /* Radius scale */
  --app-radius-xs: 10rpx;
  --app-radius-sm: 16rpx;
  --app-radius-md: 22rpx;
  --app-radius-lg: 36rpx;
  --app-radius-pill: 9999rpx;

  /* Typography */
  --app-font-display: "SF Pro Display", -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  --app-font-text: "SF Pro Text", -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;

  /* Shadow */
  --app-shadow-product: 6rpx 10rpx 60rpx 0 rgba(0, 0, 0, 0.22);

  /* ===== TDesign compatible variables (aligned with DESIGN.md) ===== */
  --td-brand-color: #0066cc;
  --td-brand-color-focus: rgba(0, 102, 204, 0.12);
  --td-brand-color-light: #e6f0fa;
  --td-brand-color-active: #0052a3;
  --td-warning-color: #f97316;
  --td-warning-color-light: #fff1e8;
  --td-warning-color-active: #ea580c;
  --td-success-color: #16a34a;
  --td-success-color-light: #ecfdf3;
  --td-error-color: #ef4444;
  --td-error-color-light: #fef2f2;
  --td-bg-color-page: #f5f5f7;
  --td-bg-color-container: #ffffff;
  --td-bg-color-secondarycontainer: #fafafc;
  --td-bg-color-component: #f5f5f7;
  --td-bg-color-component-active: #e0e0e0;
  --td-text-color-primary: #1d1d1f;
  --td-text-color-secondary: #7a7a7a;
  --td-text-color-placeholder: #a1a1a6;
  --td-text-color-disabled: #cccccc;
  --td-text-color-anti: #ffffff;
  --td-component-border: #e0e0e0;
  --td-radius-small: 12rpx;
  --td-radius-medium: 20rpx;
  --td-radius-large: 28rpx;
  --td-radius-default: 20rpx;
  --td-font-family: "SF Pro Text", -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;

  /* ===== App-level aliases (backward compatible) ===== */
  --app-bg: var(--app-color-canvas-parchment);
  --app-surface: var(--app-color-canvas);
  --app-surface-muted: var(--app-color-surface-pearl);
  --app-text: var(--app-color-body);
  --app-text-secondary: var(--app-color-ink-muted-48);
  --app-text-muted: #98a2b3;
  --app-border: var(--app-color-hairline);
  --app-primary: var(--app-color-primary);
  --app-primary-weak: var(--app-color-primary-light);
  --app-success: var(--td-success-color);
  --app-danger: var(--td-error-color);
  --app-warning: var(--td-warning-color);

  background: var(--app-bg);
  color: var(--app-text);
  font-size: 28rpx;
  line-height: 1.47;
  min-height: 100%;
  font-family: var(--app-font-text);
}
.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: var(--app-color-canvas-parchment);
}

.card {
  background: var(--app-surface);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--app-border);
  box-shadow: none;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
  color: var(--app-text);
  line-height: 1.35;
}

.sub {
  color: var(--app-text-secondary);
  font-size: 24rpx;
  line-height: 1.6;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--app-text);
  line-height: 1.35;
}

.section-subtitle {
  font-size: 24rpx;
  color: var(--app-text-secondary);
  line-height: 1.6;
}

.page-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
}

.page-head .title {
  margin-bottom: 8rpx;
}

.page-head .sub {
  max-width: 460rpx;
}

.btn-row,
.modal-actions,
.search-bar,
.tabs,
.stat-grid,
.action-grid {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.search-bar {
  align-items: center;
  flex-wrap: nowrap;
  margin-bottom: 24rpx;
}

.search-bar .input,
.search-bar .search-input {
  flex: 1;
  min-width: 0;
}

.search-bar button {
  flex-shrink: 0;
}

.input,
.textarea,
.picker,
.search-input,
.ai-input {
  width: 100%;
  box-sizing: border-box;
  background: var(--app-surface);
  border: 1rpx solid var(--app-border);
  border-radius: 16rpx;
  padding: 22rpx;
  color: var(--app-text);
  font-size: 28rpx;
  line-height: 1.5;
}

.input,
.search-input,
.ai-input {
  min-height: 96rpx;
}

.textarea {
  min-height: 180rpx;
  line-height: 1.6;
}

.primary-btn,
.search-btn,
.add-btn,
.save-btn,
.edit-btn,
.tab.active,
.stat-item,
.menu-item,
.btn-primary {
  background: var(--app-color-primary);
  color: var(--app-color-on-primary);
}

.cancel-btn,
.btn-ghost {
  background: var(--app-color-surface-pearl);
  color: var(--app-color-ink-muted-80);
}

.del-btn,
.danger-btn,
.logout-btn {
  background: var(--app-danger);
  color: var(--app-color-on-primary);
}

.search-btn,
.add-btn,
.edit-btn,
.save-btn,
.cancel-btn,
.del-btn,
.primary-btn,
.btn-primary,
.btn-ghost,
.danger-btn,
.logout-btn {
  border-radius: 16rpx;
  min-height: 88rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  background: var(--app-surface);
  border-radius: 20rpx;
  border: 1rpx solid rgba(219, 228, 238, 0.9);
  box-shadow: none;
}

.log-item {
  background: var(--app-surface);
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: none;
}

.item-info {
  flex: 1;
  min-width: 0;
}

.item-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--app-text);
}

.item-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--app-text-secondary);
  line-height: 1.5;
}

.log-title,
.log-action,
.log-query {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--app-primary);
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.log-detail {
  display: block;
  font-size: 24rpx;
  color: var(--app-color-ink-muted-80);
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.log-meta {
  display: block;
  font-size: 22rpx;
  color: var(--app-text-muted);
}

.actions {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.empty {
  text-align: center;
  color: var(--app-text-muted);
  padding: 72rpx 0;
  font-size: 24rpx;
}

.modal {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(16, 24, 40, 0.56);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 32rpx;
  box-sizing: border-box;
}

.modal-show {
  display: flex;
}

.modal-content {
  width: 100%;
  max-width: 680rpx;
  background: var(--app-surface);
  border-radius: 28rpx;
  padding: 32rpx;
  box-sizing: border-box;
  max-height: 82vh;
  overflow-y: auto;
  box-shadow: none;
}

.modal-title {
  display: block;
  margin-bottom: 20rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--app-text);
}

.modal-actions {
  margin-top: 20rpx;
  justify-content: flex-end;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  padding: 12rpx 18rpx;
  border-radius: var(--app-radius-pill);
  background: var(--app-color-primary-light);
  color: var(--app-color-primary);
  font-size: 22rpx;
}

.tabs {
  background: var(--app-color-surface-pearl);
  border-radius: var(--app-radius-sm);
  padding: 6rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 12rpx;
  border-radius: var(--app-radius-sm);
  color: var(--app-color-ink-muted-80);
  font-size: 24rpx;
}

.tab.active {
  box-shadow: none;
}

.section-card {
  padding-top: 4rpx;
  padding-bottom: 4rpx;
}

.compact-card {
  padding: 20rpx;
}

.field {
  margin-bottom: 24rpx;
}

.label {
  display: block;
  margin-bottom: 10rpx;
  color: var(--app-color-ink-muted-80);
  font-size: 26rpx;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 14rpx 0;
  color: var(--app-color-ink-muted-80);
  font-size: 26rpx;
}

.stack-gap {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.full-width {
  width: 100%;
}

.muted {
  color: var(--app-text-muted);
}

.divider {
  height: 1rpx;
  background: var(--app-color-divider-soft);
  margin: 20rpx 0;
}

.state-panel {
  background: var(--app-surface);
  border: 1rpx solid var(--app-border);
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
  text-align: center;
  box-shadow: none;
}

.surface {
  background: var(--app-surface);
  border: 1rpx solid var(--app-border);
  border-radius: 24rpx;
  box-shadow: none;
}

.section-shell {
  padding: 24rpx;
}

.form-stack {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.field-row {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.field-label {
  font-size: 24rpx;
  color: var(--app-text-secondary);
  line-height: 1.5;
}

.field-note {
  font-size: 22rpx;
  color: var(--app-text-muted);
  line-height: 1.4;
}

.t-p-4 {
  padding: var(--td-spacer-4);
}

.t-px-4 {
  padding-left: var(--td-spacer-4);
  padding-right: var(--td-spacer-4);
}

.t-py-4 {
  padding-top: var(--td-spacer-4);
  padding-bottom: var(--td-spacer-4);
}

.t-mt-2 {
  margin-top: var(--td-spacer-2);
}

.t-mt-3 {
  margin-top: var(--td-spacer-3);
}

.t-mt-4 {
  margin-top: var(--td-spacer-4);
}

.t-mb-2 {
  margin-bottom: var(--td-spacer-2);
}

.t-mb-3 {
  margin-bottom: var(--td-spacer-3);
}

.t-mb-4 {
  margin-bottom: var(--td-spacer-4);
}

.t-gap-3 {
  gap: var(--td-spacer-3);
}

.t-gap-4 {
  gap: var(--td-spacer-4);
}

.content {
  padding-bottom: 40rpx;
}

.section-item,
.text-item,
.empty-hint {
  font-size: 24rpx;
  line-height: 1.7;
}

.section-item,
.text-item {
  color: var(--app-color-ink-muted-80);
}

.empty-hint {
  color: var(--app-text-muted);
  padding: 16rpx 0;
}

.file-name {
  margin-top: 10rpx;
  color: var(--app-text-secondary);
  font-size: 24rpx;
}

.link-text {
  background: var(--app-surface-muted);
  border: 1rpx solid var(--app-border);
  border-radius: 16rpx;
  padding: 18rpx;
  font-size: 22rpx;
  color: var(--app-primary);
  word-break: break-all;
  margin-bottom: 10rpx;
}

.ai-answer,
.polish-result {
  background: var(--app-surface-muted);
  border: 1rpx solid var(--app-border);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--app-text);
  line-height: 1.7;
}

.log-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--app-color-divider-soft);
}

.log-row:last-child {
  border-bottom: none;
}

.log-main {
  flex: 1;
  min-width: 0;
}

.log-arrow {
  color: var(--app-color-ink-muted-48);
  font-size: 40rpx;
  line-height: 1;
}

.ai-fab {
  position: fixed;
  right: 28rpx;
  bottom: 150rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--app-radius-pill);
  background: var(--app-color-primary);
  box-shadow: none;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ai-fab-icon {
  color: var(--app-color-on-primary);
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.ai-panel {
  position: fixed;
  right: 28rpx;
  bottom: 270rpx;
  width: calc(100vw - 56rpx);
  max-width: 470rpx;
  background: var(--app-surface);
  border-radius: 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(226, 232, 240, 0.95);
  box-shadow: none;
  z-index: 99;
  display: none;
}

.ai-panel-show {
  display: block;
}

.ai-panel-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.ai-close {
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 18rpx;
  background: var(--app-color-surface-pearl);
  color: var(--app-color-ink-muted-80);
  font-size: 28rpx;
}

button::after {
  border: none;
}
