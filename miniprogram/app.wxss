page {
  background: #f5f7fb;
  color: #1f2329;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 36rpx rgba(15, 23, 42, 0.06);
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
  color: #101828;
}

.sub {
  color: #667085;
  font-size: 24rpx;
  line-height: 1.6;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #101828;
}

.btn-row,
.modal-actions,
.search-bar,
.tabs,
.stat-grid,
.action-grid {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.search-bar {
  align-items: center;
  margin-bottom: 24rpx;
}

.input,
.textarea,
.picker,
.search-input,
.ai-input {
  width: 100%;
  box-sizing: border-box;
  background: #f8fafc;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 22rpx;
  color: #101828;
}

.textarea {
  min-height: 180rpx;
}

.primary-btn,
.search-btn,
.add-btn,
.save-btn,
.edit-btn,
.tab.active,
.stat-item,
.menu-item,
.btn-primary {
  background: linear-gradient(135deg, #1677ff, #4f46e5);
  color: #fff;
}

.cancel-btn,
.btn-ghost {
  background: #eef2f7;
  color: #344054;
}

.del-btn,
.danger-btn,
.logout-btn {
  background: linear-gradient(135deg, #ff4d4f, #d92d20);
  color: #fff;
}

.search-btn,
.add-btn,
.edit-btn,
.save-btn,
.cancel-btn,
.del-btn,
.primary-btn,
.btn-primary,
.btn-ghost,
.danger-btn,
.logout-btn {
  border-radius: 16rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.04);
}

.item-info {
  flex: 1;
  min-width: 0;
}

.item-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #101828;
}

.item-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #667085;
  line-height: 1.5;
}

.actions {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.empty {
  text-align: center;
  color: #98a2b3;
  padding: 72rpx 0;
  font-size: 24rpx;
}

.modal {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(16, 24, 40, 0.56);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 32rpx;
  box-sizing: border-box;
}

.modal-show {
  display: flex;
}

.modal-content {
  width: 100%;
  max-width: 680rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 32rpx;
  box-sizing: border-box;
  max-height: 82vh;
  overflow-y: auto;
  box-shadow: 0 24rpx 80rpx rgba(15, 23, 42, 0.2);
}

.modal-title {
  display: block;
  margin-bottom: 20rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #101828;
}

.modal-actions {
  margin-top: 20rpx;
  justify-content: flex-end;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #175cd3;
  font-size: 22rpx;
}

.tabs {
  background: #eef2ff;
  border-radius: 20rpx;
  padding: 6rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 12rpx;
  border-radius: 16rpx;
  color: #475467;
  font-size: 24rpx;
}

.muted {
  color: #98a2b3;
}

.divider {
  height: 1rpx;
  background: #edf0f5;
  margin: 20rpx 0;
}

button::after {
  border: none;
}
