<view class="page resume-detail-page">
  <block wx:if="{{loading}}">
    <view class="card state-card">
      <text class="state-text">Loading...</text>
    </view>
  </block>

  <block wx:elif="{{resume}}">
    <view class="card hero-card">
      <view class="hero-head">
        <view class="hero-copy">
          <view class="hero-title">{{resume.title || 'My Resume'}}</view>
          <view class="hero-sub">{{resume.summary || 'No summary yet'}}</view>
        </view>
        <button class="hero-btn" size="mini" bindtap="goEdit">Edit</button>
      </view>
      <view class="hero-meta">
        <text class="meta-pill">Status: {{resume.status || '-'}}</text>
        <text class="meta-pill">Modules: {{resume.enabled_modules ? resume.enabled_modules.length : 0}}</text>
        <text class="meta-pill">Tags: {{tags.length}}</text>
      </view>
    </view>

    <view class="card" wx:if="{{moduleList.length}}">
      <view class="section-title">Modules</view>
      <view class="module-grid">
        <view
          wx:for="{{moduleList}}"
          wx:key="name"
          wx:for-item="module"
          class="module-item {{module.checked ? 'module-item-active' : ''}}"
          data-name="{{module.name}}"
          bindtap="toggleModule"
        >
          <text class="module-label">{{module.label}}</text>
          <text class="module-status">{{module.checked ? 'Enabled' : 'Disabled'}}</text>
        </view>
      </view>
    </view>

    <block wx:for="{{sections}}" wx:key="title" wx:for-item="section">
      <view class="card">
        <view class="section-title">{{section.title}}</view>
        <block wx:if="{{section.kind == 'object'}}">
          <view class="section-item" wx:for="{{section.items}}" wx:key="title" wx:for-item="row">
            <text class="item-title">{{row.title}}</text>
            <text class="item-desc">{{row.desc}}</text>
          </view>
        </block>
        <block wx:else>
          <view class="text-item" wx:for="{{section.items}}" wx:key="*this" wx:for-item="text">{{text}}</view>
        </block>
      </view>
    </block>

    <view class="card">
      <view class="section-title">Tags</view>
      <view wx:if="{{tags.length}}" class="tag-list">
        <view
          class="tag {{tag.selected ? 'tag-selected' : ''}}"
          wx:for="{{tags}}"
          wx:key="id"
          wx:for-item="tag"
          data-value="{{tag.id}}"
          bindtap="toggleTag"
        >
          {{tag.name}}
        </view>
      </view>
      <view wx:else class="empty-hint">No tags yet.</view>
    </view>

    <view class="card">
      <view class="section-title">Visitor Link</view>
      <block wx:if="{{visitor.url}}">
        <view class="link-text">{{visitor.url}}</view>
        <view class="sub-line">AI: {{visitor.used}} / {{visitor.quota}}, remaining {{visitor.remaining}}</view>
        <view class="sub-line">Expires: {{visitor.expires}}</view>
        <view class="sub-line">Public modules: {{visitor.publicModulesText}}</view>
        <view class="btn-row">
          <button size="mini" bindtap="copyVisitorLink">Copy</button>
          <button size="mini" bindtap="refreshVisitorLink" loading="{{visitorLoading}}">Refresh</button>
          <button size="mini" type="primary" bindtap="generateVisitorLink">Generate</button>
          <button size="mini" type="warn" bindtap="disableVisitorLink">Disable</button>
        </view>
      </block>
      <block wx:else>
        <view class="empty-hint">No visitor link yet.</view>
        <button size="mini" type="primary" bindtap="generateVisitorLink">Generate Link</button>
      </block>
    </view>

    <view class="card action-card">
      <button class="primary-btn" bindtap="exportPdf">Export PDF</button>
      <button class="secondary-btn" bindtap="refresh">Refresh</button>
    </view>
  </block>

  <view wx:else class="card empty-card">
    <view class="hero-title">No resume yet</view>
    <view class="hero-sub">Create one first, then come back here.</view>
    <button class="primary-btn" bindtap="goEdit">Create Resume</button>
  </view>

  <user-bottom-nav active="detail"></user-bottom-nav>
</view>
