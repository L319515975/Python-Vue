.card { margin-bottom: 24rpx; }
.btn-row { margin-top: 16rpx; }
.section-title { margin-bottom: 14rpx; }
.sub-item { padding: 16rpx 0; border-bottom: 1rpx solid #edf0f5; }
.sub-item:last-child { border-bottom: none; }
.sub-title { display: block; font-weight: 700; font-size: 26rpx; color: #101828; margin-bottom: 6rpx; }
.sub-desc { display: block; font-size: 24rpx; color: #475467; line-height: 1.7; white-space: pre-wrap; }
.text-item { padding: 10rpx 0; font-size: 24rpx; color: #344054; line-height: 1.6; }
.empty-hint { color: #98a2b3; font-size: 24rpx; padding: 16rpx 0; }
.polish-btn { margin-top: 12rpx; background: #7c3aed; color: #fff; border-radius: 12rpx; font-size: 22rpx; }
.link-text { background: #f8fafc; border: 1rpx solid #e5e7eb; border-radius: 16rpx; padding: 18rpx; font-size: 22rpx; color: #175cd3; word-break: break-all; margin-bottom: 10rpx; }
.ai-chat { display: flex; gap: 16rpx; align-items: center; }
.ai-chat .input { flex: 1; }
.ai-answer, .polish-result { background: #f8fafc; border: 1rpx solid #e5e7eb; border-radius: 16rpx; padding: 20rpx; margin-top: 14rpx; font-size: 24rpx; color: #101828; line-height: 1.7; }
.file-name { font-size: 24rpx; color: #667085; margin-top: 10rpx; }
