

.resume-detail-page{
  min-height: 100vh;
  padding: 24rpx 24rpx 220rpx;
  box-sizing: border-box;
  background: #f6f8fc;
}
.card {
  margin-bottom: 20rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #fff;
  border: 1rpx solid #e5e7eb;
  box-sizing: border-box;
}

.state-card,
.empty-card,
.action-card {
  text-align: center;
}

.state-text {
  color: #475569;
  font-size: 28rpx;
}

.hero-card {
  background: linear-gradient(135deg, #0891b2 0%, #0f766e 100%);
  color: #fff;
}

.hero-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.hero-copy {
  flex: 1;
  min-width: 0;
}

.hero-title {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.3;
}

.hero-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.92);
}

.hero-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.meta-pill {
  padding: 10rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: 22rpx;
}

.hero-btn {
  flex-shrink: 0;
  background: #fff;
  color: #0f766e;
}

.secondary-btn {
  margin-top: 12rpx;
  background: #f1f5f9;
  color: #0f172a;
}

.section-title {
  margin-bottom: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.module-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.module-item {
  width: calc(50% - 6rpx);
  padding: 18rpx;
  border-radius: 14rpx;
  border: 1rpx solid #dbe4ee;
  background: #f8fafc;
  box-sizing: border-box;
}

.module-item-active {
  border-color: #0891b2;
  background: linear-gradient(135deg, #0891b2 0%, #0f766e 100%);
}

.module-label {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #0f172a;
}

.module-status {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #64748b;
}

.module-item-active .module-label,
.module-item-active .module-status {
  color: #fff;
}

.section-item {
  padding: 16rpx 0;
  border-top: 1rpx solid #edf2f7;
}

.section-item:first-child {
  border-top: none;
  padding-top: 0;
}

.item-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #0f172a;
}

.item-desc,
.text-item,
.sub-line,
.link-text,
.empty-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #475569;
  white-space: pre-wrap;
  word-break: break-all;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  padding: 12rpx 16rpx;
  border-radius: 999rpx;
  border: 1rpx solid #dbe4ee;
  background: #fff;
  color: #334155;
  font-size: 22rpx;
}

.tag-selected {
  border-color: #0891b2;
  background: #0891b2;
  color: #fff;
}

.link-text {
  color: #0891b2;
}

.btn-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.primary-btn {
  margin-top: 12rpx;
  background: #0891b2;
  color: #fff;
}

@media (max-width: 768rpx) {
  .module-item {
    width: 100%;
  }

  .hero-head {
    flex-direction: column;
  }
}
