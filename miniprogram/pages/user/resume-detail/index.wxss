.resume-detail-page {
  min-height: 100vh;
  padding-bottom: 320rpx;
}

.hero-card {
  background: linear-gradient(135deg, #0f8bff 0%, #1d4ed8 62%, #0ea5e9 100%);
  color: #fff;
  overflow: hidden;
  border-color: rgba(255, 255, 255, 0.14);
  box-shadow: 0 18rpx 44rpx rgba(15, 139, 255, 0.18);
}

.hero-card .title,
.hero-card .sub {
  color: #fff;
}

.hero-top,
.section-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.hero-copy {
  flex: 1;
  min-width: 0;
}

.hero-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.section-card {
  padding-top: 24rpx;
  padding-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--app-text);
  line-height: 1.35;
}

.section-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--app-text-secondary);
}

.module-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.module-item {
  min-height: 126rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  border: 1rpx solid var(--app-border);
  background: var(--app-surface-muted);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.module-item-active {
  background: linear-gradient(135deg, #0f8bff, #1d4ed8);
  border-color: transparent;
  box-shadow: 0 12rpx 28rpx rgba(15, 139, 255, 0.16);
}

.module-label {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--app-text);
  line-height: 1.35;
}

.module-status {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--app-text-secondary);
}

.module-item-active .module-label,
.module-item-active .module-status {
  color: #fff;
}

.section-item {
  padding: 16rpx 0;
  border-top: 1rpx solid rgba(219, 228, 238, 0.9);
}

.section-item:first-child {
  border-top: none;
  padding-top: 0;
}

.item-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--app-text);
  line-height: 1.35;
}

.item-desc,
.text-item,
.sub-line,
.link-text,
.empty-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--app-text-secondary);
  white-space: pre-wrap;
  word-break: break-word;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  padding: 12rpx 16rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--app-border);
  background: var(--app-surface-muted);
  color: var(--app-text);
  font-size: 22rpx;
}

.tag-selected {
  border-color: var(--app-primary);
  background: var(--app-primary);
  color: #fff;
}

.link-text {
  color: var(--app-primary);
}

.btn-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.action-card {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.state-card,
.empty-card {
  text-align: center;
}

button::after {
  border: none;
}

@media (max-width: 768rpx) {
  .module-grid {
    grid-template-columns: 1fr;
  }

  .hero-top,
  .section-head {
    flex-direction: column;
  }
}
.ai-fab {
  position: fixed;
  right: 28rpx;
  bottom: 150rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #0f8bff, #0ea5e9);
  box-shadow: 0 16rpx 34rpx rgba(15, 139, 255, 0.32);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ai-panel {
  position: fixed;
  right: 28rpx;
  bottom: 270rpx;
  width: calc(100vw - 56rpx);
  max-width: 470rpx;
  background: var(--app-surface);
  border-radius: 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(226, 232, 240, 0.95);
  box-shadow: 0 20rpx 56rpx rgba(16, 24, 40, 0.16);
  z-index: 99;
  display: none;
}

.ai-panel-show {
  display: block;
}

.ai-panel-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  gap: 16rpx;
}

.ai-close {
  width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  background: #f2f4f7;
  color: #475467;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ai-summary {
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: var(--app-surface-muted);
  border: 1rpx solid var(--app-border);
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--app-text-secondary);
  margin-bottom: 14rpx;
}

button::after {
  border: none;
}