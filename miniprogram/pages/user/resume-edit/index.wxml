<view class="page resume-edit-page">
  <view class="card header-card">
    <view class="header-row">
      <view class="header-copy">
        <view class="title">{{resume ? 'Edit Resume' : 'Create Resume'}}</view>
        <view class="sub">Update the title, summary, and sub items.</view>
      </view>
      <button class="secondary-btn" wx:if="{{resume}}" size="mini" bindtap="goDetail">View Detail</button>
    </view>
  </view>

  <view class="card">
    <view class="section-title">Basic Info</view>
    <view class="field">
      <text class="label">Title</text>
      <input class="input" placeholder="Enter resume title" value="{{form.title}}" bindinput="onTitleInput" />
    </view>
    <view class="field">
      <text class="label">Summary</text>
      <textarea class="textarea" placeholder="Enter a short summary" value="{{form.summary}}" bindinput="onSummaryInput"></textarea>
    </view>
    <button class="primary-btn" loading="{{loading}}" bindtap="saveResume">Save</button>
  </view>

  <view class="card">
    <view class="section-head">
      <text class="section-title">Education</text>
      <button class="mini-btn" data-type="education" bindtap="showAddSubItem">Add</button>
    </view>
    <view wx:if="{{educations.length}}">
      <view class="sub-item" wx:for="{{educations}}" wx:key="id" wx:for-item="row">
        <text class="sub-name">{{row.school}} - {{row.major}}</text>
        <view class="sub-actions">
          <button size="mini" data-type="education" data-id="{{row.id}}" bindtap="editSubItem">Edit</button>
          <button size="mini" type="warn" data-type="education" data-id="{{row.id}}" bindtap="deleteSubItem">Delete</button>
        </view>
      </view>
    </view>
    <view wx:else class="empty-hint">No education records.</view>
  </view>

  <view class="card">
    <view class="section-head">
      <text class="section-title">Work</text>
      <button class="mini-btn" data-type="work" bindtap="showAddSubItem">Add</button>
    </view>
    <view wx:if="{{workExperiences.length}}">
      <view class="sub-item" wx:for="{{workExperiences}}" wx:key="id" wx:for-item="row">
        <text class="sub-name">{{row.company}} - {{row.position}}</text>
        <view class="sub-actions">
          <button size="mini" data-type="work" data-id="{{row.id}}" bindtap="editSubItem">Edit</button>
          <button size="mini" type="warn" data-type="work" data-id="{{row.id}}" bindtap="deleteSubItem">Delete</button>
        </view>
      </view>
    </view>
    <view wx:else class="empty-hint">No work records.</view>
  </view>

  <view class="card">
    <view class="section-head">
      <text class="section-title">Projects</text>
      <button class="mini-btn" data-type="project" bindtap="showAddSubItem">Add</button>
    </view>
    <view wx:if="{{projects.length}}">
      <view class="sub-item" wx:for="{{projects}}" wx:key="id" wx:for-item="row">
        <text class="sub-name">{{row.name}}</text>
        <view class="sub-actions">
          <button size="mini" data-type="project" data-id="{{row.id}}" bindtap="editSubItem">Edit</button>
          <button size="mini" type="warn" data-type="project" data-id="{{row.id}}" bindtap="deleteSubItem">Delete</button>
        </view>
      </view>
    </view>
    <view wx:else class="empty-hint">No project records.</view>
  </view>

  <view class="card">
    <view class="section-head">
      <text class="section-title">Skills</text>
      <button class="mini-btn" data-type="skill" bindtap="showAddSubItem">Add</button>
    </view>
    <view wx:if="{{skills.length}}">
      <view class="sub-item" wx:for="{{skills}}" wx:key="id" wx:for-item="row">
        <text class="sub-name">{{row.name}} ({{row.level || 0}}%)</text>
        <view class="sub-actions">
          <button size="mini" data-type="skill" data-id="{{row.id}}" bindtap="editSubItem">Edit</button>
          <button size="mini" type="warn" data-type="skill" data-id="{{row.id}}" bindtap="deleteSubItem">Delete</button>
        </view>
      </view>
    </view>
    <view wx:else class="empty-hint">No skills yet.</view>
  </view>

  <view class="modal {{showSubForm ? 'modal-show' : ''}}">
    <view class="modal-content" wx:if="{{showSubForm}}">
      <text class="modal-title">{{subFormData.id ? 'Edit' : 'Add'}} {{subFormType === 'education' ? 'Education' : subFormType === 'work' ? 'Work' : subFormType === 'project' ? 'Project' : 'Skill'}}</text>

      <block wx:if="{{subFormType == 'education'}}">
        <input class="input" placeholder="School" value="{{subFormData.school}}" data-field="school" bindinput="subFormInput" />
        <input class="input" placeholder="Degree" value="{{subFormData.degree}}" data-field="degree" bindinput="subFormInput" />
        <input class="input" placeholder="Major" value="{{subFormData.major}}" data-field="major" bindinput="subFormInput" />
        <input class="input" placeholder="Start date" value="{{subFormData.start_date}}" data-field="start_date" bindinput="subFormInput" />
        <input class="input" placeholder="End date" value="{{subFormData.end_date}}" data-field="end_date" bindinput="subFormInput" />
      </block>

      <block wx:elif="{{subFormType == 'work'}}">
        <input class="input" placeholder="Company" value="{{subFormData.company}}" data-field="company" bindinput="subFormInput" />
        <input class="input" placeholder="Position" value="{{subFormData.position}}" data-field="position" bindinput="subFormInput" />
        <input class="input" placeholder="Start date" value="{{subFormData.start_date}}" data-field="start_date" bindinput="subFormInput" />
        <input class="input" placeholder="End date" value="{{subFormData.end_date}}" data-field="end_date" bindinput="subFormInput" />
      </block>

      <block wx:elif="{{subFormType == 'project'}}">
        <input class="input" placeholder="Project name" value="{{subFormData.name}}" data-field="name" bindinput="subFormInput" />
        <input class="input" placeholder="Role" value="{{subFormData.role}}" data-field="role" bindinput="subFormInput" />
        <input class="input" placeholder="Tech stack" value="{{subFormData.tech_stack}}" data-field="tech_stack" bindinput="subFormInput" />
        <input class="input" placeholder="Start date" value="{{subFormData.start_date}}" data-field="start_date" bindinput="subFormInput" />
        <input class="input" placeholder="End date" value="{{subFormData.end_date}}" data-field="end_date" bindinput="subFormInput" />
      </block>

      <block wx:elif="{{subFormType == 'skill'}}">
        <input class="input" placeholder="Skill name" value="{{subFormData.name}}" data-field="name" bindinput="subFormInput" />
        <input class="input" placeholder="Level 0-100" value="{{subFormData.level}}" data-field="level" bindinput="subFormInput" />
        <input class="input" placeholder="Category" value="{{subFormData.category}}" data-field="category" bindinput="subFormInput" />
      </block>

      <view class="modal-actions">
        <button size="mini" type="warn" bindtap="hideSubForm">Cancel</button>
        <button size="mini" type="primary" bindtap="saveSubItem">Save</button>
      </view>
    </view>
  </view>

  <user-bottom-nav active="edit"></user-bottom-nav>
</view>
