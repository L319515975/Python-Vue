.resume-edit-page {
  min-height: 100vh;
  padding-bottom: 220rpx;
}

.hero-card {
  background: var(--app-color-surface-tile-1);
  color: var(--app-color-body-on-dark);
  overflow: hidden;
  border-color: rgba(255, 255, 255, 0.14);
  box-shadow: 0 18rpx 44rpx rgba(15, 139, 255, 0.18);
}

.hero-card .title,
.hero-card .sub {
  color: var(--app-color-body-on-dark);
}

.header-row,
.section-head,
.sub-item-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.header-copy,
.sub-copy {
  flex: 1;
  min-width: 0;
}

.section-card {
  padding-top: 24rpx;
  padding-bottom: 24rpx;
}

.section-head {
  margin-bottom: 4rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--app-text);
  line-height: 1.35;
}

.section-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--app-text-secondary);
}

.form-stack {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.field-row {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.field-label {
  font-size: 24rpx;
  color: var(--app-text-secondary);
  line-height: 1.5;
}

.field-shell {
  min-height: 96rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: stretch;
  background: var(--app-surface);
  border: 1rpx solid var(--app-border);
  border-radius: 18rpx;
  box-sizing: border-box;
  transition: border-color 180ms ease, box-shadow 180ms ease;
}

.field-shell-textarea {
  min-height: 220rpx;
  padding-top: 14rpx;
  padding-bottom: 14rpx;
  align-items: stretch;
}

.field-shell.is-focused {
  border-color: var(--app-color-primary);
  box-shadow: 0 0 0 4rpx rgba(0, 102, 204, 0.08);
}

.field-input,
.field-textarea {
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  --td-input-bg-color: transparent;
  --td-input-border-color: transparent;
  --td-input-vertical-padding: 0rpx;
  --td-input-default-text-color: var(--app-text);
  --td-input-placeholder-text-color: var(--td-text-color-placeholder);
  --td-textarea-bg-color: transparent;
  --td-textarea-border-color: transparent;
  --td-textarea-default-text-color: var(--app-text);
  --td-textarea-placeholder-text-color: var(--td-text-color-placeholder);
}

.item-list {
  display: flex;
  flex-direction: column;
}

.sub-item {
  padding: 20rpx 0;
  border-top: 1rpx solid rgba(219, 228, 238, 0.9);
}

.sub-item:first-child {
  border-top: none;
  padding-top: 0;
}

.sub-item-head {
  align-items: center;
}

.sub-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--app-text);
  line-height: 1.35;
}

.sub-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--app-text-secondary);
  line-height: 1.5;
}

.sub-text {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--app-color-ink-muted-48);
}

.sub-actions {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.modal {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.42);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s ease;
  z-index: 1100;
}

.modal-show {
  opacity: 1;
  pointer-events: auto;
}

.modal-content {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  max-height: 82vh;
  overflow: auto;
  border-radius: 24rpx;
  background: var(--app-surface);
  padding: 28rpx;
  box-sizing: border-box;
  box-shadow: 0 24rpx 80rpx rgba(15, 23, 42, 0.18);
}

.modal-title {
  display: block;
  margin-bottom: 20rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--app-text);
}

.modal-actions {
  display: flex;
  gap: 12rpx;
  justify-content: flex-end;
  flex-wrap: wrap;
}

button::after {
  border: none;
}
