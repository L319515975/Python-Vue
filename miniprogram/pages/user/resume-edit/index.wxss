.resume-edit-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 220rpx;
  box-sizing: border-box;
  background: #f6f8fc;
}

.card {
  margin-bottom: 20rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #fff;
  border: 1rpx solid #e5e7eb;
  box-sizing: border-box;
}

.header-row,
.section-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.header-copy {
  flex: 1;
  min-width: 0;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.3;
  color: #0f172a;
}

.sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #64748b;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.field {
  margin-bottom: 18rpx;
}

.label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 24rpx;
  color: #334155;
}

.input,
.textarea {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid #dbe4ee;
  border-radius: 14rpx;
  background: #fff;
  padding: 18rpx 20rpx;
  font-size: 26rpx;
  color: #0f172a;
}

.textarea {
  min-height: 160rpx;
}

.primary-btn {
  margin-top: 8rpx;
  background: #0891b2;
  color: #fff;
}

.secondary-btn,
.mini-btn {
  background: #f1f5f9;
  color: #0f172a;
}

.mini-btn {
  flex-shrink: 0;
}

.sub-item {
  padding: 16rpx 0;
  border-top: 1rpx solid #edf2f7;
}

.sub-item:first-child {
  border-top: none;
  padding-top: 0;
}

.sub-name {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #0f172a;
}

.sub-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
  flex-wrap: wrap;
}

.empty-hint {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #64748b;
}

.modal {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.4);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s ease;
  z-index: 1100;
}

.modal-show {
  opacity: 1;
  pointer-events: auto;
}

.modal-content {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  max-height: 78vh;
  overflow: auto;
  border-radius: 18rpx;
  background: #fff;
  padding: 24rpx;
  box-sizing: border-box;
}

.modal-title {
  display: block;
  margin-bottom: 18rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.modal-content .input + .input {
  margin-top: 12rpx;
}

.modal-actions {
  display: flex;
  gap: 12rpx;
  justify-content: flex-end;
  margin-top: 18rpx;
  flex-wrap: wrap;
}

@media (max-width: 768rpx) {
  .header-row,
  .section-head {
    flex-direction: column;
  }
}
