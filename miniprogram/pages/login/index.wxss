.login-page {
  min-height: 100vh;
  background: var(--app-color-canvas-parchment);
}

.login-container {
  min-height: 100vh;
  padding: 32rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.login-skeleton {
  padding-top: 8rpx;
}

.hero {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.brand-mark {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: var(--app-color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 24rpx rgba(15, 139, 255, 0.18);
  flex-shrink: 0;
}

.brand-mark-text {
  color: var(--app-color-on-primary);
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.hero-copy {
  flex: 1;
  min-width: 0;
}

.hero-title {
  font-size: 36rpx;
  line-height: 1.3;
  font-weight: 700;
  color: var(--app-color-ink-muted-80);
}

.hero-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--app-color-ink-muted-48);
}

.feature-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.feature-tag {
  border-radius: 999rpx;
}

.login-card {
  background: var(--app-color-canvas);
  border: 1rpx solid var(--app-color-hairline);
  border-radius: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  padding: 28rpx;
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--app-color-ink-muted-80);
  line-height: 1.35;
}

.section-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--app-color-ink-muted-48);
  line-height: 1.5;
}

.security-pill {
  min-height: 52rpx;
  padding: 0 18rpx;
  border-radius: var(--app-radius-pill);
  background: var(--app-color-primary-light);
  color: var(--app-color-primary);
  font-size: 22rpx;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
}

.form {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.field-label-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 16rpx;
}

.field-label {
  font-size: 28rpx;
  color: var(--app-color-ink-muted-80);
  font-weight: 600;
}

.field-hint {
  font-size: 22rpx;
  color: var(--td-text-color-placeholder);
}

.field-shell {
  min-height: 96rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: stretch;
  background: var(--app-color-canvas);
  border: 1rpx solid var(--app-color-hairline);
  border-radius: 18rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
  box-sizing: border-box;
  transition: border-color 180ms ease, box-shadow 180ms ease;
}

.field-shell.is-focused {
  border-color: var(--app-color-primary);
  box-shadow: 0 0 0 4rpx rgba(0, 102, 204, 0.08);
}

.field-input {
  flex: 1;
  height: 96rpx;
  min-width: 0;
  --td-input-bg-color: transparent;
  --td-input-vertical-padding: 0rpx;
  --td-input-border-color: transparent;
  --td-input-placeholder-text-color: var(--app-color-body-muted);
  --td-input-default-text-color: var(--app-color-ink-muted-80);
  --td-input-suffix-text-color: var(--app-color-primary);
  --td-input-suffix-icon-color: var(--td-text-color-placeholder);
}

.login-placeholder {
  color: var(--app-color-body-muted);
  font-size: 28rpx;
}

.login-btn {
  --td-button-border-radius: 18rpx;
  box-shadow: 0 16rpx 30rpx rgba(15, 139, 255, 0.18);
}

.quick-section {
  margin-top: 24rpx;
}

.quick-title {
  margin-bottom: 14rpx;
  color: var(--app-color-ink-muted-80);
  font-size: 24rpx;
  font-weight: 600;
}

.quick-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.quick-item {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.quick-btn {
  --td-button-border-radius: 18rpx;
}

.quick-desc {
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--app-color-ink-muted-48);
  padding-left: 4rpx;
}

.page-note {
  margin-top: 18rpx;
  padding: 0 4rpx;
  color: var(--td-text-color-placeholder);
  font-size: 22rpx;
  line-height: 1.6;
}

.login-card,
.login-skeleton {
  width: 100%;
}

button::after {
  border: none;
}