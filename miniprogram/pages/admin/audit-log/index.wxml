<view class="page">
  <view class="search-bar">
    <input class="input" placeholder="操作类型（如 user_create）" value="{{searchAction}}" bindinput="onActionInput" />
    <button class="search-btn" bindtap="loadLogs">搜索</button>
  </view>
  <view class="list">
    <view class="log-item" wx:for="{{logs}}" wx:key="id">
      <view class="log-action">{{item.action_display || item.action}}</view>
      <view class="log-detail">{{item.detail || '-'}}</view>
      <view class="log-meta">{{item.admin_user || '-'}} · {{item.created_at || ''}} · {{item.ip_address || ''}}</view>
    </view>
    <view wx:if="{{logs.length === 0 && !loading}}" class="empty">暂无审计日志</view>
  </view>
</view>
