.admin-list-page { padding-bottom: 40rpx; }
.page-head { display: flex; justify-content: space-between; align-items: center; gap: 20rpx; }
.page-head .title { margin-bottom: 8rpx; }
.page-head .add-btn { flex-shrink: 0; padding: 0 24rpx; font-size: 24rpx; }
.compact-card { padding: 20rpx; }
.search-bar .input { flex: 1; min-width: 0; }
.search-btn { padding: 0 24rpx; font-size: 24rpx; }
.item-desc { word-break: break-all; }
.picker { margin: 16rpx 0; font-size: 26rpx; color: #344054; }
.switch-row { display: flex; align-items: center; justify-content: space-between; margin: 14rpx 0; color: #344054; font-size: 26rpx; }
.modal-actions button { min-width: 150rpx; }
