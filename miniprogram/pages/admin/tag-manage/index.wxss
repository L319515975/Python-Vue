.admin-list-page {
  padding-bottom: 40rpx;
}

.page-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
}

.page-head .title {
  margin-bottom: 8rpx;
}

.tag-card {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.tag-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.search-shell {
  padding: 20rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
}

.tag-head .item-desc {
  word-break: break-all;
}

.actions {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.picker {
  margin: 0;
  min-height: 96rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  border-radius: 16rpx;
  border: 1rpx solid var(--app-border);
  background: var(--app-surface);
  font-size: 26rpx;
  color: var(--app-text);
}

.field-row {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.field-label {
  font-size: 24rpx;
  color: var(--app-text-secondary);
  line-height: 1.5;
}

.modal-content {
  max-width: 720rpx;
}

.modal-actions {
  display: flex;
  gap: 12rpx;
  justify-content: flex-end;
  flex-wrap: wrap;
}

@media (max-width: 768rpx) {
  .page-head,
  .tag-head,
  .search-bar {
    flex-direction: column;
    align-items: stretch;
  }

  .actions,
  .modal-actions {
    justify-content: flex-start;
  }
}
