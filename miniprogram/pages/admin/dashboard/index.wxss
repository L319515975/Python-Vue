.dashboard-page {
  padding-bottom: 280rpx;
}

.hero-card {
  background: linear-gradient(135deg, #0f8bff 0%, #1d4ed8 62%, #0ea5e9 100%);
  color: #fff;
  overflow: hidden;
  border-color: rgba(255, 255, 255, 0.14);
  box-shadow: 0 18rpx 44rpx rgba(15, 139, 255, 0.18);
}

.hero-card .title,
.hero-card .sub {
  color: #fff;
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
}

.hero-copy {
  flex: 1;
  min-width: 0;
}

.hero-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.hero-badge {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.hero-tip {
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.6;
  opacity: 0.92;
  max-width: 560rpx;
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-item {
  min-width: 0;
  padding: 22rpx 18rpx;
  border-radius: 24rpx;
  text-align: center;
  box-shadow: 0 12rpx 28rpx rgba(15, 23, 42, 0.06);
  min-height: 144rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.48);
 
}
 
.stat-num {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.1;
  color: var(--app-text);
}

.stat-label {
  display: block;
  font-size: 22rpx;
  opacity: 0.92;
  color: var(--app-text-secondary);
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-shell {
  margin-bottom: 24rpx;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.quick-item {
  min-height: 148rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  box-sizing: border-box;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  border: 1rpx solid var(--app-border);
  background: var(--app-surface-muted);
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.05);
}

.quick-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: var(--app-primary-weak);
  color: var(--app-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.quick-copy {
  flex: 1;
  min-width: 0;
}

.quick-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--app-text);
  line-height: 1.35;
}

.quick-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--app-text-secondary);
}

.quick-item-hover {
  border-color: var(--app-primary);
  background: #f3f9ff;
}

.action-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.menu-item {
  width: calc(50% - 8rpx);
  min-height: 138rpx;
  border-radius: 20rpx;
  padding: 24rpx 18rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  text-align: center;
  box-shadow: 0 8rpx 20rpx rgba(15, 139, 255, 0.08);
}

.menu-title {
  font-size: 28rpx;
  font-weight: 700;
  color: inherit;
}

.menu-desc {
  font-size: 22rpx;
  line-height: 1.5;
  opacity: 0.9;
}

.recent-section {
  padding-bottom: 12rpx;
}

.logout-btn {
  width: 100%;
  margin-top: 8rpx;
}

.ai-fab {
  position: fixed;
  right: 28rpx;
  bottom: 150rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #0f8bff, #0ea5e9);
  box-shadow: 0 16rpx 34rpx rgba(15, 139, 255, 0.32);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ai-fab-icon {
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.ai-panel {
  position: fixed;
  right: 28rpx;
  bottom: 270rpx;
  width: calc(100vw - 56rpx);
  max-width: 470rpx;
  background: var(--app-surface);
  border-radius: 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(226, 232, 240, 0.95);
  box-shadow: 0 20rpx 56rpx rgba(16, 24, 40, 0.16);
  z-index: 99;
  display: none;
}

.ai-panel-show {
  display: block;
}

.ai-panel-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  gap: 16rpx;
}

.ai-close {
  width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  background: #f2f4f7;
  color: #475467;
  display: flex;
  align-items: center;
  justify-content: center;
}

@media (max-width: 768rpx) {
  .hero-top,
  .section-head {
    flex-direction: column;
    align-items: stretch;
  }

  .stat-grid,
  .quick-grid {
    grid-template-columns: 1fr;
  }
}

button::after {
  border: none;
}
