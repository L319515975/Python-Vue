.dashboard-page {
  min-height: 100vh;
  padding: 32rpx;
  padding-bottom: 200rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  box-sizing: border-box;
}

/* ===== Hero Card ===== */
.hero-card {
  background: linear-gradient(135deg, #272729 0%, #1a1f3a 100%);
  color: var(--app-color-body-on-dark);
  overflow: hidden;
  border-color: rgba(255, 255, 255, 0.14);
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.hero-copy {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--app-color-body-on-dark);
  letter-spacing: -0.5rpx;
}

.sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.hero-tags {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.hero-badge {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-tip {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.65);
  line-height: 1.5;
}

/* ===== My Resume Quick Card (Prominent) ===== */
.resume-quick-card {
  background: linear-gradient(135deg, var(--app-color-primary) 0%, #0052a3 100%);
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 12rpx 32rpx rgba(0, 102, 204, 0.3);
  transition: all 0.2s ease-out;
}

.resume-quick-hover {
  transform: scale(0.98);
  box-shadow: 0 8rpx 24rpx rgba(0, 102, 204, 0.25);
}

.resume-quick-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.resume-quick-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.resume-quick-copy {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.resume-quick-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: -0.3rpx;
}

.resume-quick-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.resume-quick-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: rgba(255, 255, 255, 0.8);
}

.resume-quick-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #fff;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #fff;
  opacity: 0.8;
}

/* ===== Stats Grid ===== */
.stat-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.stat-item {
  background: var(--app-color-canvas);
  border: 1rpx solid var(--app-color-divider-soft);
  border-radius: 20rpx;
  padding: 24rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  transition: all 0.2s ease-out;
}

.stat-item-hover {
  transform: scale(0.96);
  background: var(--app-color-surface-pearl);
}

.stat-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  margin-bottom: 4rpx;
}

.stat-icon-blue {
  background: rgba(0, 102, 204, 0.1);
  color: var(--app-color-primary);
}

.stat-icon-green {
  background: rgba(22, 163, 74, 0.1);
  color: #16a34a;
}

.stat-icon-orange {
  background: rgba(234, 88, 12, 0.1);
  color: #ea580c;
}

.stat-icon-purple {
  background: rgba(124, 58, 237, 0.1);
  color: #7c3aed;
}

.stat-icon-red {
  background: rgba(239, 68, 68, 0.1);
  color: #ef4444;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--app-color-ink);
  letter-spacing: -0.5rpx;
}

.stat-label {
  font-size: 22rpx;
  color: var(--app-color-ink-muted-48);
  font-weight: 500;
}

/* ===== Section Shell ===== */
.section-shell {
  background: var(--app-color-canvas);
  border: 1rpx solid var(--app-color-divider-soft);
  border-radius: 24rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--app-color-ink);
  letter-spacing: -0.3rpx;
}

.section-subtitle {
  font-size: 24rpx;
  color: var(--app-color-ink-muted-48);
  margin-top: 4rpx;
}

/* ===== Quick Grid ===== */
.quick-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.quick-item {
  background: var(--app-color-surface-pearl);
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  transition: all 0.15s ease-out;
}

.quick-item-hover {
  transform: scale(0.96);
  background: rgba(0, 102, 204, 0.06);
}

.quick-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.quick-icon-primary {
  background: rgba(0, 102, 204, 0.1);
  color: var(--app-color-primary);
}

.quick-icon-green {
  background: rgba(22, 163, 74, 0.1);
  color: #16a34a;
}

.quick-icon-purple {
  background: rgba(124, 58, 237, 0.1);
  color: #7c3aed;
}

.quick-icon-orange {
  background: rgba(234, 88, 12, 0.1);
  color: #ea580c;
}

.quick-icon-blue {
  background: rgba(0, 102, 204, 0.1);
  color: var(--app-color-primary);
}

.quick-icon-red {
  background: rgba(239, 68, 68, 0.1);
  color: #ef4444;
}

.quick-copy {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
  flex: 1;
}

.quick-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--app-color-ink);
}

.quick-desc {
  font-size: 22rpx;
  color: var(--app-color-ink-muted-48);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ===== Recent Section ===== */
.recent-section {
  flex: 1;
}

.state-panel {
  padding: 32rpx 0;
}

/* ===== Logout Button ===== */
.logout-btn {
  background: var(--app-color-canvas);
  border: 1rpx solid var(--app-color-divider-soft);
  border-radius: 20rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--app-color-ink-muted-48);
  margin-top: 16rpx;
}

/* ===== AI FAB ===== */
.ai-fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  width: 96rpx;
  height: 96rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, var(--app-color-primary) 0%, #0052a3 100%);
  box-shadow: 0 16rpx 40rpx rgba(0, 102, 204, 0.4);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
}

.ai-fab-pulse {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 999rpx;
  background: var(--app-color-primary);
  animation: pulse 2s ease-out infinite;
  opacity: 0.4;
}

@keyframes pulse {
  0% {
    transform: scale(1);
    opacity: 0.4;
  }
  100% {
    transform: scale(1.4);
    opacity: 0;
  }
}

/* ===== AI Panel ===== */
.ai-panel {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  background: var(--app-color-canvas);
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.2);
  transform: translateY(20rpx);
  opacity: 0;
  pointer-events: none;
  transition: all 0.2s ease-out;
  z-index: 99;
  border: 1rpx solid var(--app-color-divider-soft);
}

.ai-panel-show {
  transform: translateY(0);
  opacity: 1;
  pointer-events: auto;
}

.ai-panel-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.ai-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--app-color-surface-pearl);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--app-color-ink-muted-48);
}
