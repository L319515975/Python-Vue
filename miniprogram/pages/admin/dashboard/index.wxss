.dashboard-page {
  padding-bottom: 280rpx;
}

.hero-card {
  background: linear-gradient(135deg, #1677ff 0%, #6d5efc 100%);
  color: #fff;
  overflow: hidden;
}

.hero-card .title,
.hero-card .sub {
  color: #fff;
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
}

.hero-badge {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 22rpx;
}

.hero-tip {
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.6;
  opacity: 0.92;
  max-width: 520rpx;
}

.stat-grid {
  margin-bottom: 24rpx;
}

.stat-item {
  flex: 1 1 calc(33.333% - 11rpx);
  min-width: 0;
  padding: 24rpx 18rpx;
  border-radius: 24rpx;
  text-align: center;
  box-shadow: 0 12rpx 28rpx rgba(22, 119, 255, 0.14);
  min-height: 132rpx;
}

.stat-num {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
}

.stat-label {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  opacity: 0.92;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.action-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.menu-item {
  width: calc(50% - 8rpx);
  min-height: 138rpx;
  border-radius: 20rpx;
  padding: 24rpx 18rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  text-align: center;
  box-shadow: 0 8rpx 20rpx rgba(22, 119, 255, 0.08);
}

.menu-icon {
  font-size: 44rpx;
}

.menu-title {
  font-size: 28rpx;
  font-weight: 700;
  color: inherit;
}

.menu-desc {
  font-size: 22rpx;
  line-height: 1.5;
  opacity: 0.9;
}

.log-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf0f5;
}

.log-row:last-child {
  border-bottom: none;
}

.log-main {
  flex: 1;
  min-width: 0;
}

.log-query {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #101828;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.log-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #98a2b3;
}

.log-arrow {
  color: #cbd5e1;
  font-size: 40rpx;
  line-height: 1;
}

.logout-btn {
  width: 100%;
  margin-top: 8rpx;
}
.ai-input {
  margin-bottom: 16rpx;
}
