<view class="page">
  <view class="search-bar">
    <input class="input" placeholder="搜索用户名" value="{{searchUsername}}" bindinput="onSearchInput" />
    <button class="search-btn" bindtap="loadLogs">搜索</button>
  </view>
  <view class="list">
    <view class="log-item" wx:for="{{logs}}" wx:key="id">
      <view class="log-title">{{item.call_type_display || item.call_type}} - {{item.username || '-'}}</view>
      <view class="log-detail">{{item.query_text || '-'}}</view>
      <view class="log-meta">Token: {{item.tokens_used || 0}} {{item.created_at || ''}} {{item.ip_address || ''}}</view>
    </view>
    <view wx:if="{{logs.length === 0 && !loading}}" class="empty">暂无访客 AI 日志</view>
  </view>
</view>
