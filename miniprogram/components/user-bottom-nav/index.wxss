.user-bottom-nav {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 1200;
  display: flex;
  gap: 16rpx;
}
.nav-item {
  flex: 1;
  min-height: 108rpx;
  padding: 16rpx 12rpx;
  border-radius: var(--app-radius-sm);
  background: var(--app-color-canvas);
  border: 1rpx solid var(--app-color-hairline);
  box-shadow: 0 12rpx 28rpx rgba(15, 23, 42, 0.08);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}
.nav-item-active {
  border-color: var(--app-color-primary);
  background: var(--app-color-primary);
}
.nav-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--app-color-ink);
  line-height: 1.2;
}
.nav-sub {
  font-size: 22rpx;
  color: var(--app-color-ink-muted-48);
  line-height: 1.2;
}
.nav-item-active .nav-title,
.nav-item-active .nav-sub {
  color: var(--app-color-on-primary);
}