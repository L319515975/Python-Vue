.user-bottom-nav {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 1200;
  display: flex;
  gap: 16rpx;
}
.nav-item {
  flex: 1;
  min-height: 108rpx;
  padding: 16rpx 12rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid #dbe4ee;
  box-shadow: 0 12rpx 28rpx rgba(15, 23, 42, 0.08);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}
.nav-item-active {
  border-color: #0891b2;
  background: linear-gradient(135deg, #0891b2 0%, #0f766e 100%);
}
.nav-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.2;
}
.nav-sub {
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.2;
}
.nav-item-active .nav-title,
.nav-item-active .nav-sub {
  color: #fff;
}